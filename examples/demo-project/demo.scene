  "scripts": [
    {
      "id": "file:/Users/kalob/Code/strata/examples/demo-project/scripts/CoinSpin.rg",
      "name": "CoinSpin.rg",
      "type": "script",
      "language": "rosegold",
      "content": "## Degrees per second. Shown on the Coin Inspector card.\nimport strata;\nimport math;\n## Hello:\n@export_group(\"COIN\")\n## Degrees per second. Shown on the coin inspector card.\n@export var spin: Float = 8.0;\nvar frames: Int = 0;\nvar popping: Bool = false;\nvar pop_t: Float = 0.0;\n\nsignal collected(amount: Int);\n\nfn on_ready(name: Str, x: Float, y: Float): Int {\n    print(\"[ready] coin\");\n    return 0;\n}\n\nfn on_enter(other: Str, x: Float, y: Float): Int {\n    print(f\"[enter] coin/{other}\");\n    collected.emit(1);\n    popping = true;\n    pop_t = 0.0;\n    strata.after(0.35, \"pop\");\n    return 0;\n}\n\nfn pop(): Int {\n    strata.destroy();\n    return 0;\n}\n\nfn on_destroy(): Int {\n    print(\"[gone] coin\");\n    return 0;\n}\n\n## Called every Play frame.\nfn on_update(name: Str, x: Float, y: Float, dt: Float): Int {\n    frames = frames + 1;\n    if popping {\n        pop_t = pop_t + dt;\n        var t = math.clamp(pop_t / 0.35, 0.0, 1.0);\n        strata.rot(math.lerp(spin, spin * 4.0, t));\n    } else {\n        strata.rot(spin);\n    }\n    return 0;\n}\n\nfn main(): Int {\n    return on_ready(\"Coin\", 0.0, 0.0);\n}\n\nfn on_exit(other: Str, x: Float, y: Float): Void {\n    print(f\"[exit] coin/{other}\");\n    pass;\n}\n",
      "size": "1203 B",
      "path": "/Users/kalob/Code/strata/examples/demo-project/scripts/CoinSpin.rg",
      "relativePath": "scripts/CoinSpin.rg",
      "bytes": 1137
    },
    {
      "id": "file:/Users/kalob/Code/strata/examples/demo-project/scripts/Hero.rg",
      "name": "Hero.rg",
      "type": "script",
      "language": "rosegold",
      "content": "import utils;\nimport strata;\nimport input;\n\nvar frames: Int = 0;\n\nfn on_ready(name: Str, x: Float, y: Float): Int {\n    print(\"[ready] from project\");\n    print(name);\n    strata.spawn({ \"prefab\": \"Orb\", \"x\": 80.0, \"y\": -20.0 });\n    return 0;\n}\n\nfn on_coin(amount: Int): Int {\n    print(f\"[coin] {amount}\");\n    strata.play_sound(\"jump.wav\");\n    return 0;\n}\n\nfn on_enter(other: Str, x: Float, y: Float): Int {\n    print(f\"[enter] {other}\");\n    return 0;\n}\n\nfn on_exit(other: Str, x: Float, y: Float): Int {\n    print(f\"[exit] {other}\");\n    return 0;\n}\n\nfn on_update(name: Str, x: Float, y: Float, dt: Float): Int {\n    frames = frames + 1;\n    utils.move_line(1.0, 0.0);\n    if input.pressed(\"Space\") {\n        strata.play_sound(\"jump.wav\");\n    }\n    return 0;\n}\n\nfn main(): Int {\n    return on_ready(\"Hero\", 0.0, 0.0);\n}\n",
      "size": "827 B",
      "path": "/Users/kalob/Code/strata/examples/demo-project/scripts/Hero.rg",
      "relativePath": "scripts/Hero.rg",
      "bytes": 827
    },
    {
      "id": "file:/Users/kalob/Code/strata/examples/demo-project/scripts/utils.rg",
      "name": "utils.rg",
      "type": "script",
      "language": "rosegold",
      "content": "# Shared helpers. The module name is `utils`, not this file's stem.\n\nimport strata;\n\nmod utils {\n    pub fn move_line(dx: Float, dy: Float) {\n        strata.move(dx, dy);\n    }\n}\n",
      "size": "179 B",
      "path": "/Users/kalob/Code/strata/examples/demo-project/scripts/utils.rg",
      "relativePath": "scripts/utils.rg",
      "bytes": 179
    }
  ]
