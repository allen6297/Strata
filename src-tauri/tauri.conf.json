{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Strata",
  "version": "0.1.0",
  "identifier": "com.kalob.strata",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4521",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Strata — Scene Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "2D game engine scene editor",
    "longDescription": "Strata is a lightweight 2D game engine scene editor with hierarchy, viewport, inspector, and scene save/load.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
