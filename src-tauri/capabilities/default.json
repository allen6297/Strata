{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main Strata window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "log:default",
    "allow-run-rosegold",
    "allow-run-rosegold-preview",
    "allow-check-rosegold",
    "allow-def-rosegold",
    "allow-list-rosegold-exports",
    "allow-list-rosegold-signals",
    "allow-list-rosegold-nodes",
    "allow-stdlib-rosegold",
    "allow-run-rosegold-hooks",
    "allow-list-project-files",
    "allow-list-project-entries",
    "allow-create-project-folder",
    "allow-create-project-dir",
    "allow-write-project-file",
    "allow-read-text-file",
    "allow-read-file-base64",
    "allow-engine-info",
    "allow-engine-set-scripts",
    "allow-engine-set-audio",
    "allow-engine-set-keys",
    "allow-engine-clear-play",
    "allow-engine-load-scene",
    "allow-engine-snapshot",
    "allow-engine-tick",
    "allow-sync-view-menu"
  ]
}
